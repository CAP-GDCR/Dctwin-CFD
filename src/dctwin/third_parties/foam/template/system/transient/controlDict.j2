FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantBoussinesqPimpleFoam;

startFrom       {{ start_from }};

startTime       0;

stopAt          endTime;

endTime         {{ end_time }};

deltaT          {{ delta_t }};

{% if adjust_time_step %}
writeControl    adjustableRunTime;
{% else %}
writeControl    timeStep;
{% endif %}

writeInterval   {{ write_interval }};

purgeWrite      0;

writeFormat     ascii;

writePrecision  {{ write_precision }};

writeCompression off;

timeFormat      general;

timePrecision   {{ time_precision }};

runTimeModifiable true;

{% if adjust_time_step %}
adjustTimeStep  yes;

maxCo           {{ max_co }};

maxDeltaT       {{ max_delta_t }};
{% else %}
adjustTimeStep  no;
{% endif %}

{% set surface_field_values = surface_field_values|default([]) %}
{% if probes|length > 0 or surface_field_values|length > 0 %}
functions
{
{% if probes|length > 0 %}
	probes
	{
		// Where to load it from
		libs ( "libsampling.so" );
		type probes;
		enabled true;
		// Name of the directory for probe data
		name probes;
		// Write control
{% if adjust_time_step %}
		writeControl adjustableRunTime;
{% else %}
		writeControl timeStep;
{% endif %}
		writeInterval {{ fo_write_interval }};
		// Fields to be probed
		fields
		(
			T
			rho
            p
            p_rgh
            U
		);
        probeLocations
        (
            {% for probe in probes %}
                ({{ probe.x }} {{ probe.y }} {{ probe.z }})
            {% endfor %}
        );
   }
{% endif %}
{% for fo in surface_field_values %}
    {{ fo.name }}
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
{% if adjust_time_step %}
        writeControl    adjustableRunTime;
{% else %}
        writeControl    timeStep;
{% endif %}
        writeInterval   {{ fo_write_interval }};
        log             true;
        writeFields     false;
        regionType      patch;
        name            {{ fo.patch }};
        operation       areaAverage;
        fields          (T);
    }
{% endfor %}
}
{% endif %}

// ************************************************************************* //
