FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "(U|T|k|epsilon|R)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "(U|T|k|epsilon|R)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    {{ n_outer_correctors }};
    nCorrectors         {{ n_correctors }};
    nNonOrthogonalCorrectors {{ n_non_ortho }};
    pRefCell            0;
    pRefValue           0;
}

{% if n_outer_correctors > 1 %}
relaxationFactors
{
    fields
    {
        p_rgh           {{ relax_p_rgh | default(0.7) }};
    }
    equations
    {
        U               {{ relax_U | default(0.3) }};
        T               {{ relax_T | default(0.3) }};
        "(k|epsilon)"   {{ relax_k_epsilon | default(0.3) }};
    }
}
{% endif %}

