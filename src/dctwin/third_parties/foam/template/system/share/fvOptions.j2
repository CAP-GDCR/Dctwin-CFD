FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

{% if perforated_openings %}
// ======================= Perforated Opening Zones =======================
{% for key, perforated_opening in perforated_openings.items() %}
{{key}}AirDeflection
{
    type            meanVelocityForce;
    selectionMode   cellZone;
    cellZone        {{key}}CellZone;
    fields          (U);
    Ubar            ({{perforated_opening.velocity.x}} {{perforated_opening.velocity.y}} {{perforated_opening.velocity.z}});
}
{% endfor %}
{% endif %}

{% if leakage_zones %}
// ======================= Rack Air Leakage Zones =======================
// Darcy-Forchheimer porous media model for rack air leakage
// Pressure drop: S = -(mu*d*U + 0.5*rho*|U|*f*U)
// where d = Darcy coefficient [1/m^2], f = Forchheimer coefficient [1/m]
// Orifice/perforated-plate model (Cd = 0.6):
//   d = 0  (turbulent flow, viscous term negligible)
//   f = (1/L) * ((1/(Cd*sigma)) - 1)^2
// Direction: e1 aligned with rack front-to-back (through-flow) axis

{% for zone_name, zone_config in leakage_zones.items() %}
{{zone_name}}_porosity
{
    type            explicitPorositySource;
    active          true;

    explicitPorositySourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        {{zone_config.cellzone_name}};

        type            DarcyForchheimer;

        // Darcy-Forchheimer coefficients (sigma = {{zone_config.sigma}})
        d   {{zone_config.d}};      // Darcy coefficient [1/m^2]
        f   {{zone_config.f}};      // Forchheimer coefficient [1/m]

        coordinateSystem
        {
            type    cartesian;
            origin  {{zone_config.origin}};
            rotation
            {
                type    axes;
                e1      {{zone_config.e1}};
                e2      {{zone_config.e2}};
            }
        }
    }
}
{% endfor %}
{% endif %}

// ======================= Turbulence Stabilization =======================
// Cap turbulent viscosity to prevent k-epsilon positive feedback loop
// (G = nut * |S|^2 → high k → high nut → higher G). Critical for large
// data center cases with many high-strain rack inlet/outlet jets.
limitNut
{
    type            limitTurbulenceViscosity;
    active          yes;
    selectionMode   all;
    c               1e5;
}

// ************************************************************************* //
