FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-06;
            relTol          0.01;
            nVcycles        2;
            smoother        GaussSeidel;
        }
        tolerance       1e-06;
        relTol          0.01;
        maxIter         200;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "(U|T|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0.1;
    }

    cellDisplacement
    {
        $p_rgh;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors {{ n_non_ortho_correctors | default(0) }};
    pRefCell    0;
    pRefValue   0;
{% if use_pref_point %}
    pRefPoint   ({{ pref_x }} {{ pref_y }} {{ pref_z }});
{% endif %}
    consistent  yes;

    residualControl
    {
        p_rgh           {{ res_p_rgh }};
        U               {{ res_U }};
        T               {{ res_T }};

        "(k|epsilon|omega)" {{ res_k_epsilon }};
    }
}

relaxationFactors
{
    fields
    {
        p_rgh           {{ relax_p_rgh | default(0.3) }};
    }
    equations
    {
        U               {{ relax_U | default(0.7) }};
        T               {{ relax_T | default(0.7) }};
        "(k|epsilon)"   table ((0 0.05) (50 {{ relax_k_epsilon | default(0.3) }}));
    }
}


