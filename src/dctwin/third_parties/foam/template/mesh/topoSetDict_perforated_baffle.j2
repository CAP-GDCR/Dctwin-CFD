FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// This topoSetDict creates faceZones from boundary patches for perforated baffles.
// These faceZones are then used by createBaffles to create cyclic master/slave pairs.

actions
(
{% for baffle in perforated_baffles %}
    // Create faceSet from boundary patch: {{ baffle.patch_name }}
    {
        name    {{ baffle.patch_name }}_faceSet;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo
        {
            name    "{{ baffle.patch_name }}";
        }
    }

    // Convert faceSet to faceZone
    {
        name    {{ baffle.patch_name }}_zone;
        type    faceZoneSet;
        action  new;
        source  setToFaceZone;
        sourceInfo
        {
            faceSet {{ baffle.patch_name }}_faceSet;
        }
    }

{% endfor %}
);
