FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location system;
    object createBafflesDict;
}

internalFacesOnly true;

baffles
{
    merged_wall_baffle
    {
        type        faceZone;
        zoneName    merged_wall_baffle;

        patches
        {
            master
            {
                name            merged_wall_baffle_master;
                type            cyclic;
                neighbourPatch  merged_wall_baffle_slave;
            }
            slave
            {
                name            merged_wall_baffle_slave;
                type            cyclic;
                neighbourPatch  merged_wall_baffle_master;
            }
        }
    }
}
