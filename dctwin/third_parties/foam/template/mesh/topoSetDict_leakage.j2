FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Create cellZones for leakage regions (white-box volumetric model)
// Used for applying Darcy-Forchheimer source terms via fvOptions

actions
(
{% for zone_name, zone_config in leakage_zones.items() %}
    // Create cellSet for {{ zone_name }}
    {
        name    {{ zone_name }}Set;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     ({{ zone_config.bbox_min.x }} {{ zone_config.bbox_min.y }} {{ zone_config.bbox_min.z }}) ({{ zone_config.bbox_max.x }} {{ zone_config.bbox_max.y }} {{ zone_config.bbox_max.z }});
    }
    // Convert cellSet to cellZone
    {
        name    {{ zone_name }};
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     {{ zone_name }}Set;
    }
{% endfor %}
);

