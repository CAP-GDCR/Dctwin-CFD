FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Merge leakage patch into a unified internal_wall patch
// This removes the separate merged_leakage patch

pointSync false;

patches
(
{% if has_leakage %}
    // Rename merged_leakage to internal_wall (keeps as wall type)
    {
        name internal_leakage_wall;
        
        patchInfo
        {
            type wall;
        }
        
        constructFrom patches;
        
        patches ( merged_leakage );
    }
{% endif %}
);

