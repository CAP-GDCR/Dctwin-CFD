FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner
        {
        	preconditioner GAMG;
        	tolerance       1e-08;
        	relTol          0.01;
        	nVcycles	2;
        	smoother DICGaussSeidel;
        	nPreSweeps	2;
        }
        tolerance       1e-08;
        relTol          0.01;
        maxIter 	100;
    }

    p_rghFinal
    {
        solver          PCG;
        preconditioner
        {
        	preconditioner GAMG;
        	tolerance       2e-09;
        	relTol          0;
        	nVcycles	2;
        	smoother DICGaussSeidel;
        	nPreSweeps	2;
        }
        tolerance       1e-09;
        relTol          0;
        maxIter 	100;
    }

    "(U|T|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0.1;
    }

    cellDisplacement
    {
        $p_rgh;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell    0;
    pRefValue   0;
    adjustPhi   no;

    residualControl
    {
        p_rgh           {{ res_p_rgh }};
        U               {{ res_U }};
        T               {{ res_T }};

        "(k|epsilon|omega)" {{ res_k_epsilon }};
    }
}

relaxationFactors
{
    fields
    {
        p_rgh           0.3;
    }
    equations
    {
        U               0.7;
        T               0.5;
        "(k|epsilon)"   0.3;
    }
}


